post_install() {
    echo "=== PF2E Codex installed ==="
    echo "Run 'pf2e-codex index' to build your rules database."
    echo "Run 'pf2e-codex mcp' to start the MCP server."
    echo ""
    echo "GPU acceleration (AMD):"
    echo "  Install 'migraphx' and 'rocm-hip-runtime' and rebuild:"
    echo "    makepkg -Cf && sudo pacman -U pf2e-codex-*.pkg.tar.zst"
    echo "  The PKGBUILD auto-detects AMD GPUs at build time."
    echo ""
    echo "Pre-compiling ONNX models for GPU..."
    echo "  (This may take several minutes — safe to interrupt, will resume on first query)"
    pf2e-codex warmup --threads 2 2>&1 || true
}

post_upgrade() {
    post_install
}
